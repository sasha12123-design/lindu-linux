// lindu linux — панель waybar (сессия Wayland)
// Оформление цветов задаёт программа настроек: ~/.config/lindu/theme.conf
{
    "layer": "top",
    "position": "bottom",
    "height": 34,
    "spacing": 6,
    "reload_interval": 10,

    "modules-left": ["custom/start", "custom/install", "custom/wifi", "custom/settings", "window"],
    "modules-center": [],
    "modules-right": ["tray", "clock", "custom/exit"],

    "custom/start": {
        "format": "☰ ПУСК",
        "on-click": "rofi -show drun -i",
        "tooltip": true
    },
    "custom/install": {
        "format": "⬇ УСТАНОВКА",
        "on-click": "pkexec /usr/local/bin/lindu-install-gtk",
        "tooltip": true
    },
    "custom/wifi": {
        "format": "⇩ СЕТИ",
        "on-click": "/usr/local/bin/lindu-wifi",
        "tooltip": true
    },
    "custom/settings": {
        "format": "⚙ НАСТРОЙКИ",
        "on-click": "lindu-settings",
        "tooltip": true
    },
    "custom/exit": {
        "format": "⏻",
        "on-click": "swaymsg exit",
        "tooltip": true
    },

    "window": {
        "format": "{title}",
        "max-length": 42,
        "separate-blocks": false,
        "sort-by": "focus",
        "ignore-workspace": false
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<big>{:%A, %d %B %Y}</big><br><span color='#7fd4f0'>{:%H:%M}</span>"
    }
}