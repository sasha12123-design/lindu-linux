# tint2 — нижний таскбар в стиле Windows
# среда: lindu linux live (X11, без композитора)

#---------------------------------------------
# Panel
panel_items = LTSC
panel_size = 100% 34
panel_margin = 0 0 0 0
panel_padding = 2 2 2
panel_background_id = 0
panel_position = bottom center horizontal
panel_layer = bottom
panel_monitor = 1
panel_dock = 0
panel_shrink = 0
panel_autohide = 0

#---------------------------------------------
# Launcher (кнопки приложений, слева)
launcher_padding = 3 2 3
launcher_background_id = 0
launcher_icon_background_id = 0
launcher_item_app = /usr/share/applications/lindu-menu.desktop
launcher_item_app = /usr/share/applications/lindu-install.desktop
launcher_item_app = /usr/share/applications/alacritty.desktop
launcher_item_app = /usr/share/applications/thunar.desktop
launcher_item_app = /usr/share/applications/firefox.desktop
launcher_tooltip = 1

#---------------------------------------------
# Taskbar (открытые окна, по центру)
taskbar_mode = multi_desktop
taskbar_hide_if_empty = 0
taskbar_padding = 4 3 4
taskbar_background_id = 0
taskbar_active_background_id = 1
taskbar_name = 1
taskbar_name_padding = 10 4 10
taskbar_name_active_background_id = 1
taskbar_icon_size = 20
taskbar_distribute_size = 0
taskbar_sort_order = none
taskbar_hide_inactive = 0
taskbar_flash_background_id = 2

#---------------------------------------------
# Systray (трей, слева направо)
systray_padding = 6 2 6
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 22
systray_icon_spacing = 0

#---------------------------------------------
# Clock (часы, справа)
time1_format = %H:%M
time1_font = DejaVu Sans 11
time2_format = %a %d.%m
time2_font = DejaVu Sans 8
clock_font_color = #ffffff 100
clock_padding = 10 0
clock_background_id = 0
clock_tooltip = %A %d %B %Y

#---------------------------------------------
# Tooltip
tooltip_show_timeout = 0 30
tooltip_hide_timeout = 0 0
tooltip_padding = 4 4
tooltip_background_id = 0

#---------------------------------------------
# Background 0: панель (синяя, как таскбар Windows)
rounded = 0
border_width = 0
background_color = #1f387b 100
border_color = #000000 100
background_retain = 0

#---------------------------------------------
# Background 1: активная кнопка задачи
rounded = 2
border_width = 1
background_color = #3a56a5 100
border_color = #a6c1ff 70
background_retain = 0

#---------------------------------------------
# Background 2: мигание задачи
rounded = 2
border_width = 1
background_color = #7aa2f7 100
border_color = #ffffff 90
background_retain = 0