# lindu linux — конфигурация Sway (сессия Wayland)
#
# Клавиши те же, что в сессии X11:
#   Mod = клавиша Windows
#   Mod+D  программы         Mod+W  сети (Wi-Fi)
#   Mod+E  файлы             Mod+Enter терминал
#   Mod+,  настройки         Mod+Shift+I установщик
#   Mod+B  панель            Mod+Q  выйти из сессии
#   Mod+Shift+C закрыть окно Mod+Shift+R перечитать настройки
#
# Синтаксис соответствует sway 1.11 и новее (цвета задаются через client.*).

set $mod Mod4
set $term alacritty
set $menu rofi -show drun -i
set $files thunar
set $wifi /usr/local/bin/lindu-wifi
set $setup /usr/local/bin/lindy-settings
set $install pkexec /usr/local/bin/lindu-install-gtk

# ------------------------------------------------------------- внешний вид
default_border pixel 2
default_floating_border pixel 1
gaps inner 6
gaps outer 2
gaps horizontal 6
gaps vertical 4
titlebar_border_thickness 2
titlebar_padding 8 4
title_align left
hide_edge_borders --i3 both
focus_follows_mouse yes
focus_on_window_activation urgent
mouse_warping output
font "DejaVu Sans 10"
default_orientation horizontal
workspace_layout default
xwayland enable

# ------------------------------------------------------------- цвета (палитра lindu)
client.focused          #7fd4f0 #1b2340 #ffffff
client.focused_inactive #6f8ab0 #1b2340 #e8ecf8
client.unfocused        #2f3f75 #161c33 #9aa5c2
client.urgent           #ff7a7a #2a1a20 #ffffff #ff7a7a
client.background       #0a0f22

# ------------------------------------------------------------- клавиатура и мышь
input * {
    xkb_layout "us,ru"
    xkb_numlock enabled
    pointer_accel 0.0
    accel_profile flat
}
# раскладки переключаются клавишей CapsLock — как привыкли в сессии X11
bindsym Caps_Lock input type:keyboard xkb_switch_layout next

# ------------------------------------------------------------- рабочие области
workspace 1
workspace 2
workspace 3
workspace 4
workspace 5
workspace 6
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+bracketleft workspace prev
bindsym $mod+bracketright workspace next

# ------------------------------------------------------------- окна и мышь
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+f fullscreen
bindsym $mod+space floating toggle
bindsym $mod+Shift+space floating enable
bindsym $mod+Shift+s splith
bindsym $mod+Shift+v splitv
bindsym $mod+Shift+Left move left
bindsym $mod+r mode "resize"
bindsym $mod+Shift+q mode "resize"
bindsym Escape mode "resize"
bindsym $mod+Shift+c kill
bindsym $mod+Shift+r reload
bindsym $mod+Shift+e exec swaymsg exit

# ------------------------------------------------------------- запуск программ
# Панель, обои и портал запускаем здесь: у потомков sway есть WAYLAND_DISPLAY.
# pkill перед стартом — чтобы перечитывание конфигурации не плодило копии.
exec sh -c "pkill -x waybar >/dev/null 2>&1; sleep 0.3; (waybar >/dev/null 2>&1 &)"
exec sh -c "pkill -x swaybg >/dev/null 2>&1; sleep 0.3; (swaybg -m fill -c '#0a0f22' /usr/share/backgrounds/lindy.png >/dev/null 2>&1 &)"
exec sh -c "pkill -f xdg-desktop-portal >/dev/null 2>&1; sleep 0.3; (xdg-desktop-portal >/dev/null 2>&1 &)"

bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+w exec $wifi
bindsym $mod+e exec $files
bindsym $mod+comma exec $setup
bindsym $mod+Shift+i exec $install
bindsym $mod+q exec swaymsg exit
# панель: убрать, если нарисована, иначе показать
bindsym $mod+b exec sh -c "pkill -x waybar >/dev/null 2>&1 || (waybar >/dev/null 2>&1 &)"
# буфер обмена
bindsym $mod+c exec wl-copy
bindsym $mod+v exec wl-paste
# звук
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec pactl set-source-mute @DEFAULT_ALSA_SOURCE@ toggle
# яркость
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set -5%

# ------------------------------------------------------------- окна без плитки
for_window [app_id="thunar"] floating enable
for_window [app_id="nm-connection-editor"] floating enable
for_window [app_id="pavucontrol"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_role="file-chooser"] floating enable

# ------------------------------------------------------------- питание
bindsym $mod+Shift+Delete exec systemctl poweroff
bindsym $mod+Shift+BackSpace exec systemctl reboot