/* lindu linux — оформление списков (программы, окна, сети).
   Цвета подставляет программа настроек: ~/.config/lindu/theme.conf */

configuration {
    modi: "drun,window";
    display-drun: "Программы";
    display-window: "Окна";
    font: "DejaVu Sans 12";
    show-icons: true;
    icon-theme: "hicolor";
    drun-display-format: "{name}";
    width: 720px;
    lines: 14;
    border: 0;
    border-radius: 18px;
    padding: 12px;
    spacing: 10px;
    animations: "sway";
    animation-duration: 12;
    window-dragging: 8;
}

* {
    background: transparent;
    text-color: #e8ecf8;
    border: 0;
    margin: 0px;
    padding: 0px;
}

window {
    background: #1b2340;
    border-radius: 18px;
    padding: 12px;
    spacing: 10px;
}

inputbar {
    background: #2f3f75;
    text-color: #ffffff;
    padding: 8px;
    spacing: 8px;
    border-radius: 12px;
}

text-input {
    background: #2f3f75;
    text-color: #ffffff;
    border: 0;
    border-radius: 12px;
    padding: 6px;
}

element place-holder {
    text-color: #7fd4f0;
}

listview {
    background: transparent;
    lines: 14;
    spacing: 4px;
    scrollbar: false;
    cycle: true;
    dynamic: true;
}

element {
    background: transparent;
    text-color: #e8ecf8;
    padding: 8px;
    spacing: 10px;
    border-radius: 10px;
}

element selected {
    background: #2f3f75;
    text-color: #7fd4f0;
}

element active {
    background: #2f3f75;
    text-color: #ffffff;
}

element-icon {
    size: 24px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
}
