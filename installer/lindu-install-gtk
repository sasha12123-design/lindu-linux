    # ---------- страница 5: готово ----------

    def build_done(self):
        p = self.page("Установка завершена",
                      "lindu linux установлен. Перезагрузите компьютер "
                      "(предварительно извлеките носитель).")
        self.bt_reboot = Gtk.Button(label="Перезагрузить")
        self.bt_reboot.get_style_context().add_class(Gtk.STYLE_CLASS_SUGGESTED_ACTION)
        self.bt_reboot.connect("clicked", self.on_reboot)
        p.pack_start(self.bt_reboot, False, False, 0)
        self.done_idx = len(self.pages)
        return self.add_page(p)

    # ---------- навигация ----------

    def on_back(self, w):
        if self.index > 0:
            self.goto(self.index - 1)

    def on_next(self, w):
        if self.index + 1 < len(self.pages):
            self.goto(self.index + 1)

    def on_reboot(self, w):
        self.destroy()
        subprocess.Popen(["umount", "-R", MOUNT])
        try:
            os.execvp("reboot", ["reboot", "-f"])
        except OSError:
            pass

    # ---------- установка ----------

    def on_start_install(self, w):
        if not self.disk_combo.get_active_iter():
            d = Gtk.MessageDialog(transient_for=self,
                                  message_type=Gtk.MessageType.ERROR,
                                  buttons=Gtk.ButtonsType.CLOSE,
                                  text="Диск не выбран")
            d.format_secondary_text("На странице «Выбор диска» отметьте диск для установки.")
            d.run()
            d.destroy()
            return
        self.bt_start.set_sensitive(False)
        self.bt_back.set_sensitive(False)
        self.setup = self.collect()
        self.log_write("== параметры: %r" % (self.safe_setup(),))
        self.start_flush()
        threading.Thread(target=self.worker, daemon=True).start()
        self.tick_id = GLib.timeout_add(120, self.tick)

    def safe_setup(self):
        """Параметры установки без паролей — их не нужно писать на флешку."""
        s = dict(self.setup or {})
        for k in ("pl", "pr", "password", "passwd"):
            if s.get(k):
                s[k] = "***"
        return s

    def collect(self):
        itr = self.disk_combo.get_active_iter()
        return dict(
            disk="/dev/" + self.store[itr][1].split("/")[-1],
            fs=self.fs_combo.get_active_text(),
            swap=bool(self.swap_sw.get_active()),
            host=self.host_entry.get_text().strip(),
            tz=self.tz_combo.get_active_text(),
            pl=self.p_lindu.get_text() if not self.def_sw.get_active() else "lindu",
            pr=self.p_root.get_text() if not self.def_sw.get_active() else "lindu",
        )

    # — обновления UI безопасные для главного потока —

    def ui_status(self, text=None, frac=None):
        if text is not None and text != self.stage:
            self.stage = text
            self.log_write("== %s" % text)

        def _apply():
            if text is not None and text != self.status.get_text():
                self.status.set_text(text)
            if frac is not None:
                self.progress.set_fraction(max(0.0, min(frac, 1.0)))
        GLib.idle_add(_apply)

    def log_write(self, line):
        """Дописать строку в файловый лог (для отчёта и для внешнего носителя)."""
        fh = self.logfh
        if fh is None:
            try:
                fh = self.logfh = open(LOGPATH, "a", encoding="utf-8",
                                       errors="replace", buffering=1)
            except Exception:
                return
        try:
            fh.write(str(line).rstrip("\n") + "\n")
            fh.flush()
        except Exception:
            pass

    def ui_log(self, line):
        self.log_write(line)
        GLib.idle_add(self._append_log, line)

    # ---------- дублирование лога на флешку (на случай зависания) ----------

    def start_flush(self):
        self.stop_flush()
        self.flush_id = GLib.timeout_add(5000, self.flush_media)

    def stop_flush(self):
        if self.flush_id is not None:
            try:
                GLib.source_remove(self.flush_id)
            except Exception:
                pass
            self.flush_id = None

    def flush_media(self):
        """Раз в 5 с кладём свежий лог на все доступные внешние носители."""
        if rep is None or self.setup is None:
            return True
        disk = self.setup.get("disk")

        def job():
            try:
                with self.report_lock:
                    dirs = rep.media_dirs(disk, MOUNT)
                    if dirs:
                        self.media = dirs
                        rep.live_snapshot(LOGPATH, disk, MOUNT, dirs=dirs,
                                          stage=self.stage, setup=self.safe_setup())
            except Exception:
                pass

        threading.Thread(target=job, daemon=True).start()
        return True

    def on_save_log(self, w):
        """Кнопка «сохранить лог на носитель» — вручную, без ошибки."""
        if rep is None:
            return

        def job():
            done = {}
            try:
                disk = (self.setup or {}).get("disk")
                dirs = rep.media_dirs(disk, MOUNT)
                written = []
                if dirs:
                    written, _ = rep.live_snapshot(LOGPATH, disk, MOUNT, dirs=dirs,
                                                   stage=self.stage,
                                                   setup=self.safe_setup())
                done = {"written": written or [],
                        "file": "снимок журнала", "failed": []}
            except Exception as e:
                done = {"written": [], "file": "", "failed": [str(e)]}
            GLib.idle_add(self.show_info, "Журнал сохранён", done)
        threading.Thread(target=job, daemon=True).start()

    def show_info(self, title, done):
        paths = done.get("written") or []
        d = Gtk.MessageDialog(transient_for=self,
                              message_type=Gtk.MessageType.INFO,
                              buttons=Gtk.ButtonsType.CLOSE,
                              text=title)
        if paths:
            body = "Журнал установки сохранён:\n" + "\n".join("- " + p for p in paths)
        else:
            body = ("Не найдено внешних носителей с файловой системой.\n"
                    "Вставьте флешку FAT32 и нажмите кнопку ещё раз.")
        d.format_secondary_text(body)
        d.run()
        d.destroy()

    def dump_report_async(self, reason, tb=""):
        """Собрать полный отчёт об ошибке и сохранить на носители."""
        def job():
            disk = (self.setup or {}).get("disk")
            try:
                if rep is None:
                    done = {"written": [LOGPATH], "file": LOGPATH, "failed": []}
                else:
                    with self.report_lock:
                        done = rep.dump(reason=reason, logpath=LOGPATH, target=disk,
                                        mount=MOUNT, tb=tb, setup=self.safe_setup(),
                                        stage=self.stage)
            except Exception as e:
                done = {"written": [], "file": "", "failed": ["%s" % e]}
            GLib.idle_add(self.show_error, reason, done)

        threading.Thread(target=job, daemon=True).start()

    def _append_log(self, line):
        self.logbuf.insert(self.logbuf.get_end_iter(), line + "\n")
        adj = self.log.get_vadjustment()
        adj.set_value(adj.get_upper())

    # — выполнение команд (рабочий поток) —

    def run(self, argv, desc, check=True):
        self.ui_log("> " + " ".join(str(a) for a in argv))
        try:
            pro = subprocess.Popen(argv, stdout=subprocess.PIPE,
                                   stderr=subprocess.STDOUT, text=True)
        except OSError as e:
            self.ui_log("!! %s" % e)
            GLib.idle_add(self.finish, False, "%s: %s" % (desc, e), "")
            raise SystemExit(1)
        last_out = time.time()
        warned = False
        while True:
            ready, _, _ = select.select([pro.stdout], [], [], 1.0)
            if not ready:
                if pro.poll() is not None:
                    break
                # процесс молчит: сообщаем, но не мешаем (лог всё равно пишется)
                if not warned and time.time() - last_out > 120:
                    warned = True
                    self.ui_log("!! %s: нет вывода больше 120 с — возможно зависание; "
                                "журнал продолжает сохраняться на носитель" % desc)
                continue
            line = pro.stdout.readline()
            if not line:
                break
            self.ui_log(line.rstrip())
            last_out = time.time()
            warned = False
        for line in pro.stdout:
            self.ui_log(line.rstrip())
        code = pro.wait()
        if check and code != 0:
            GLib.idle_add(self.finish, False, "Команда завершилась с кодом %d:\n%s" % (code, " ".join(argv)), "")
            raise SystemExit(1)
        return code

    def check_network(self):
        """Интернет ДО разметки диска: без сети pacstrap ничего не скачает."""
        def sh(cmd, timeout=25):
            try:
                p = subprocess.run(cmd, stdout=subprocess.PIPE,
                                   stderr=subprocess.STDOUT, text=True,
                                   errors="replace", timeout=timeout)
                return p.returncode, (p.stdout or "").strip()
            except Exception as e:
                return 1, "%s: %s" % (type(e).__name__, e)

        self.ui_log("> проверка доступа в интернет")
        # сеть может быть просто не поднята (в live-образе NM поднимается при загрузке)
        sh(["systemctl", "start", "NetworkManager"], 20)
        time.sleep(1.5)
        rc, links = sh(["ip", "-4", "-o", "addr", "show"], 15)
        has_ip = any(re.search(r"\binet \d+\.\d+\.\d+\.\d+", l) and " lo " not in l
                     for l in links.splitlines())
        rc, out = sh(["curl", "-sS", "-I", "--max-time", "12",
                      "https://geo.mirror.pkgbuild.com/extra/extra.db"], 25)
        if rc == 0:
            self.ui_log("   сеть есть, зеркало Arch доступно")
            return True, ""
        tail = (out.splitlines() or ["нет ответа"])[-1]
        self.ui_log("!! сеть недоступна: %s" % tail[:200])
        if not has_ip:
            return False, ("Нет подключения к интернету. Установка невозможна: нужны "
                           "пакеты из репозитория Arch.\n\nПодключите сетевой кабель "
                           "или Wi-Fi: в live-системе нажмите Win+W "
                           "(или запустите lindu-wifi) и выберите сеть.\n"
                           "Диск не тронут: разметка не началась.")
        return False, ("Интернет не работает: сеть подключена, но зеркало Arch "
                       "недоступно.\n\nПроверьте интернет и повторите установку.\n"
                       "Диск не тронут: разметка не началась.")

    def root_ok(self):
        """В целевой системе должно быть базовое окружение."""
        return os.path.isdir(MOUNT + "/bin")

    def chroot_run(self, body):
        if not self.root_ok():
            GLib.idle_add(self.finish, False,
                          "Целевая система не заполнена: нет %s/bin.\n"
                          "Значит, установка пакетов не удалась — чаще всего нет "
                          "интернета.\nДиск можно использовать повторно." % MOUNT, "")
            raise SystemExit(1)
        d = os.path.join(MOUNT, "root")
        try:
            os.makedirs(d, exist_ok=True)
        except Exception as e:
            GLib.idle_add(self.finish, False,
                          "Не удалось создать %s: %s" % (d, e), "")
            raise SystemExit(1)
        path = os.path.join(d, ".lsc")
        try:
            with open(path, "w") as f:
                f.write(body)
        except OSError as e:
            GLib.idle_add(self.finish, False,
                          "Не удалось записать служебный файл %s: %s" % (path, e), "")
            raise SystemExit(1)
        try:
            self.run(["arch-chroot", MOUNT, "/bin/bash", "/root/.lsc"],
                     "chroot", check=True)
        finally:
            if os.path.exists(path):
                os.remove(path)


    def worker(self):
        try:
            s = self.setup
            disk, fs = s["disk"], s["fs"]
            esp, rootdev = part_dev(disk, 2), part_dev(disk, 3)
            swapdev = part_dev(disk, 4) if s["swap"] else None

            self.ui_status("Проверка интернета", 0.15 / 9.0)
            ok, why = self.check_network()
            if not ok:
                GLib.idle_add(self.finish, False, why, "")
                return

            # очистка от предыдущего запуска (повторная установка/отмонтированный /mnt)
            self.run(["bash", "-c",
                      "swapoff -a 2>/dev/null; umount -R %s 2>/dev/null; sync; true" % MOUNT],
                     "очистка", check=False)

            mklayout = [
                ["parted", "-s", disk, "mklabel", "gpt"],
                ["parted", "-s", disk, "mkpart", "BIOS_GRUB", "1MiB", "2MiB"],
                ["parted", "-s", disk, "set", "1", "bios_grub", "on"],
                ["parted", "-s", disk, "mkpart", "ESP", "fat32", "2MiB", "514MiB"],
                ["parted", "-s", disk, "set", "2", "esp", "on"],
            ]
            if s["swap"]:
                mklayout.append(["parted", "-s", disk, "mkpart", "root", fs, "514MiB", "98%"])
                mklayout.append(["parted", "-s", disk, "mkpart", "swap", "linux-swap", "98%", "100%"])
            else:
                mklayout.append(["parted", "-s", disk, "mkpart", "root", fs, "514MiB", "100%"])
            mklayout.append(["bash", "-c", "sleep 1; partprobe %s || true" % disk])

            fmt = [["mkfs.fat", "-F32", esp]]
            if swapdev:
                fmt.append(["mkswap", swapdev])
            mkroot = ["mkfs.%s" % fs, "-f" if fs == "btrfs" else "-F", rootdev]
            fmt.append(mkroot)

            mnt = [["mount", rootdev, MOUNT],
                   ["mkdir", "-p", MOUNT + "/boot"],
                   ["mount", esp, MOUNT + "/boot"]]
            if swapdev:
                mnt.append(["swapon", swapdev])

            total = 9.0
            self.ui_status("Разметка диска", 0.5 / total)
            for c in mklayout:
                self.run(c, "разметка")
            self.ui_status("Форматирование", 1.5 / total)
            for c in fmt:
                self.run(c, "форматирование")
            self.ui_status("Монтирование", 2.5 / total)
            for c in mnt:
                self.run(c, "монтирование")

            self.ui_status("Подготовка ключей pacman...", 2.8 / total)
            self.run(["pacman-key", "--init"], "ключи pacman")
            self.run(["pacman-key", "--populate", "archlinux"], "ключи pacman")

            self.ui_status("Установка пакетов (pacstrap)...", 3.5 / total)
            self.run(["pacstrap", MOUNT,
                      *PKGS_BASE, *PKGS_DESKTOP, *PKGS_EXTRA], "pacstrap")
            if not self.root_ok():
                GLib.idle_add(self.finish, False,
                              "Установка пакетов не удалась: в %s нет /bin.\n"
                              "Чаще всего это отсутствие интернета или недоступное "
                              "зеркало Arch.\nДиск можно использовать повторно." % MOUNT, "")
                raise SystemExit(1)
            self.run(["bash", "-c", "genfstab -U %s > %s/etc/fstab" % (MOUNT, MOUNT)], "fstab")

            self.ui_status("Настройка системы", 5.5 / total)
            self.chroot_setup(s)

            self.ui_status("Загрузчик GRUB", 6.5 / total)
            self.bootloader(s)

            self.ui_status("Среда lindu", 7.5 / total)
            self.install_lindu()

            GLib.idle_add(self.finish, True, "")
        except SystemExit:
            return
        except Exception as e:
            GLib.idle_add(self.finish, False, str(e), traceback.format_exc())

    # — шаги — 

    def chroot_setup(self, s):
        zone = s["tz"]
        if zone and not os.path.exists("/usr/share/zoneinfo/" + zone):
            zone = ""
        zc = "ln -sf /usr/share/zoneinfo/%s /etc/localtime" % zone if zone else "# tz: utc"
        lp = bq("lindu:" + s["pl"])
        rp = bq("root:" + s["pr"])
        body = """set -e
echo {host} > /etc/hostname
printf 'KEYMAP=us\\n' > /etc/vconsole.conf
{zc} || true
printf 'en_US.UTF-8 UTF-8\\nru_RU.UTF-8 UTF-8\\n' > /etc/locale.gen
locale-gen >/dev/null
printf 'LANG=en_US.UTF-8\\nLC_COLLATE=C\\n' > /etc/locale.conf
id lindu >/dev/null 2>&1 || useradd -m -G wheel,audio,video,storage,power,lp,rfkill -s /bin/bash lindu
echo {lp} | chpasswd
echo {rp} | chpasswd
printf '%%wheel ALL=(ALL:ALL) ALL\\n' > /etc/sudoers.d/10-lindu
chmod 440 /etc/sudoers.d/10-lindu
systemctl enable NetworkManager
systemctl enable sshd
""".format(host=bq(s["host"].strip()), zc=zc, lp=lp, rp=rp)
        self.chroot_run(body)

    def bootloader(self, s):
        if os.path.isdir("/sys/firmware/efi"):
            self.chroot_run("""set -e
grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=lindu --recheck
grub-mkconfig -o /boot/grub/grub.cfg
""")
        else:
            self.run(["bash", "-c",
                      "arch-chroot %s /bin/bash -c 'set -e; grub-install --recheck --no-floppy %s; "
                      "grub-mkconfig -o /boot/grub/grub.cfg'" % (MOUNT, s["disk"])], "grub")

    def install_lindu(self):
        if os.path.exists("/usr/local/bin/lindu-wm"):
            self.run(["install", "-D", "-m755", "/usr/local/bin/lindu-wm",
                      MOUNT + "/usr/local/bin/lindu-wm"], "lindu-wm")
        # Wi-Fi-помощник (кнопка на панели и Win+W есть и в установленной системе)
        if os.path.exists("/usr/local/bin/lind" "u-wifi"):
            self.run(["install", "-D", "-m755", "/usr/local/bin/lind" "u-wifi",
                      MOUNT + "/usr/local/bin/lind" "u-wifi"], "lindu-wifi")
        if os.path.exists("/usr/share/applications/lind" "u-wifi.desktop"):
            self.run(["install", "-D", "-m644",
                      "/usr/share/applications/lind" "u-wifi.desktop",
                      MOUNT + "/usr/share/applications/lind" "u-wifi.desktop"],
                     "ярлык Wi-Fi")
        self.run(["bash", "-c", "mkdir -p %s/usr/share/backgrounds && "
                  "[ -f /usr/share/backgrounds/lindu.png ] || exit 0; "
                  "install -Dm644 /usr/share/backgrounds/lindu.png "
                  "%s/usr/share/backgrounds/lindu.png" % (MOUNT, MOUNT)], "обои")
        self.run(["bash", "-c", "[ -f /etc/os-release ] && cp /etc/os-release "
                  "%s/etc/os-release || true" % MOUNT], "os-release")
        self.run(["bash", "-c", "mkdir -p %s/etc/skel && cp -r /etc/skel/. %s/etc/skel/ || true"
                  % (MOUNT, MOUNT)], "dotfiles")
        self.chroot_run("""set -e
mkdir -p /etc/systemd/system/getty@tty1.service.d
printf '[Service]\\nExecStart=\\nExecStart=-/usr/bin/agetty --autologin lindu --noclear %%I $TERM\\n' \\
    > /etc/systemd/system/getty@tty1.service.d/autologin.conf
cp -a /etc/skel/. /home/lindu/
chown -R lindu:lindu /home/lindu
systemctl enable getty@tty1
""")

    def tick(self):
        self.progress.pulse()
        return True

    def finish(self, ok, msg="", tb=""):
        if self.tick_id is not None:
            GLib.source_remove(self.tick_id)
            self.tick_id = None
        self.bt_back.set_sensitive(True)
        self.ui_status("Готово" if ok else "Ошибка", 1.0 if ok else None)
        self.stop_flush()
        if not ok:
            self.log_write("!! ОШИБКА УСТАНОВКИ: %s" % (msg or "неизвестно"))
            self.ui_log("!! ОШИБКА УСТАНОВКИ: %s" % (msg or "неизвестно"))
            self.dump_report_async(msg or "неизвестная ошибка", tb)
            return
        self.goto(self.done_idx)

    def show_error(self, msg, done):
        try:
            buf = self.logbuf.get_text(self.logbuf.get_start_iter(),
                                       self.logbuf.get_end_iter(), True)
        except Exception:
            buf = ""
        d = Gtk.MessageDialog(transient_for=self,
                              message_type=Gtk.MessageType.ERROR,
                              buttons=Gtk.ButtonsType.CLOSE,
                              text="Установка не завершена")
        body = msg or ""
        try:
            tail = "\n".join(buf.rstrip().splitlines()[-20:])
            if tail and tail not in body:
                body += "\n\n--- журнал (хвост) ---\n" + tail
        except Exception:
            pass
        paths = list(done.get("written") or [])
        if paths:
            body += ("\n\n--- ПОЛНЫЙ ЛОГ СОХРАНЁН В ФАЙЛ ---\n"
                     "%s\n%s\n\nСкопируйте этот файл на флешку и покажите его "
                     "(можно просто открыть текстовым редактором)."
                     % (done.get("file") or "отчёт",
                        "\n".join("- " + p for p in paths)))
        else:
            body += ("\n\nОтчёт удалось сохранить только в оперативной памяти: %s\n"
                     "Вставьте флешку с FAT32 (или карту памяти) и повторите "
                     "установку — журнал будет писаться на носитель."
                     % (done.get("file") or LOGPATH))
        d.format_secondary_text(body)
        d.run()
        d.destroy()
        self.goto(self.install_idx)


class LinduApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.lindu.installer")

    def do_activate(self):
        win = InstallerWindow(self)
        win.show_all()


def emergency_dump(reason, tb=""):
    """Аварийный дамп: GUI упал или процесс убит — пишем отчёт в последний раз."""
    try:
        sys.stderr.write("lindu-install-gtk: %s\n" % reason)
        if rep is not None:
            rep.dump(reason=reason, logpath=LOGPATH, mount=MOUNT, tb=tb,
                     stage="аварийное завершение")
    except Exception:
        pass


def main():
    def hook(etype, value, tback):
        try:
            emergency_dump("необработанное исключение: %s" % value,
                           "".join(traceback.format_exception(etype, value, tback)))
        finally:
            sys.__excepthook__(etype, value, tback)
    sys.excepthook = hook

    def on_signal(sig, _frm):
        emergency_dump("установщик остановлен сигналом %d" % sig)
        os._exit(1)
    for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        try:
            signal.signal(s, on_signal)
        except Exception:
            pass

    app = LinduApp()
    app.run(sys.argv)


if __name__ == "__main__":
    main()