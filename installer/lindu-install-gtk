    # ---------- страница 3: пароли ----------

    def build_passwords(self):
        p = self.page("Пароли", "По умолчанию: пользователь lindu / lindu, root / lindu.")
        defrow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        defrow.pack_start(Gtk.Label(label="Использовать пароли по умолчанию"), False, False, 0)
        self.def_sw = Gtk.Switch()
        self.def_sw.set_active(True)
        defrow.pack_start(self.def_sw, False, False, 0)
        p.pack_start(defrow, False, False, 0)

        grid = Gtk.Grid(row_spacing=10, column_spacing=14)
        grid.attach(Gtk.Label(label="Пользователь lindu", halign=Gtk.Align.START), 0, 0, 1, 1)
        self.p_lindu = Gtk.Entry(visibility=False)
        grid.attach(self.p_lindu, 1, 0, 1, 1)
        grid.attach(Gtk.Label(label="root", halign=Gtk.Align.START), 0, 1, 1, 1)
        self.p_root = Gtk.Entry(visibility=False)
        grid.attach(self.p_root, 1, 1, 1, 1)
        p.pack_start(grid, False, False, 0)

        def sync(*a):
            for e in (self.p_lindu, self.p_root):
                e.set_visible(not self.def_sw.get_active())
                e.set_sensitive(not self.def_sw.get_active())
            self.goto(self.index)
        self.def_sw.connect("notify::active", sync)
        for e in (self.p_lindu, self.p_root):
            e.connect("changed", lambda w: self.goto(self.index))
        sync()
        return self.add_page(p, lambda: self.def_sw.get_active()
                             or (self.p_lindu.get_text() and self.p_root.get_text()))

