# (флешку), чтобы его можно было принести на другой компьютер.
sys.path.insert(0, "/usr/lib/lindu")
try:
    import lindu_install_report as rep
except ImportError:
    try:
        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
        import lindu_install_report as rep
    except ImportError:
        rep = None

