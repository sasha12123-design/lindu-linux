#!/usr/bin/env bash
# lindu-wifi — подключение к Wi-Fi без терминала.
# Показывает список доступных сетей (rofi), спрашивает пароль и подключает.
# Работает и без графики: если запустить в терминале — печатает подсказку.

set -uo pipefail

say() { printf '%s\n' "$*"; }

msg() {
    # сообщение пользователю: окном rofi, а без rofi — просто текстом
    if have_gui; then
        printf '%s' "$1" | rofi -dmenu -i -width 60% -lines 8 \
            -p "Wi-Fi" >/dev/null 2>&1 || true
    else
        say "$1"
    fi
}

have_nm() { command -v nmcli >/dev/null 2>&1; }

# есть ли графическая сессия (иначе rofi ругается на отсутствие дисплея)
have_gui() {
    [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] || return 1
    command -v rofi >/dev/null 2>&1 || return 1
    return 0
}

# nmcli от пользователя, а если не хватило прав — через polkit
nm() {
    if nmcli "$@"; then
        return 0
    fi
    if command -v pkexec >/dev/null 2>&1; then
        pkexec nmcli "$@"
        return $?
    fi
    return 1
}

radio() { nmcli radio wifi 2>/dev/null | awk '/enabled/{print $2; exit}'; }

current_ssid() {
    nmcli -t -f NAME,TYPE,STATE device 2>/dev/null |
        awk -F: '$2=="wifi" && $3=="connected"{print $1; exit}'
}

# список сетей: SSID<TAB>уровень<TAB>защита
networks() {
    nmcli -t -f SSID,SIGNAL,SECURITY device wifi list --rescan yes 2>/dev/null |
        sed 's/\\:/:/g' |
        awk -F: '$1 != "" && $1 != "--" {
                 sec = ($3 == "" ? "open" : $3);
                 printf "%s\t%s\t%s\n", $1, $2, sec;
               }' |
        sort -t"$(printf "\t")" -k2,2nr | awk '!seen[$0]++'
}

usage() {
    cat <<'EOF'
Подключение к Wi-Fi: lindu-wifi            (список сетей в окне, пароль там же)
Проверить подключение:  nmcli networking connectivity check
Подключиться вручную:   nmcli device wifi connect "Имя_сети" password "пароль"
Включить/выключить Wi-Fi: nmcli radio wifi on | nmcli radio wifi off
EOF
}

main() {
    if ! have_nm; then
        msg "nmcli не найден: в системе нет NetworkManager"
        return 1
    fi

    # без графической сессии — только подсказка в терминале
    if ! have_gui; then
        usage
        return 0
    fi

    local st
    st="$(radio)"
    if [ "$st" != "enabled" ]; then
        nm radio wifi on >/dev/null 2>&1 || true
        sleep 1
    fi

    local list cur
    cur="$(current_ssid)"
    # строка списка: полоски <TAB> имя <TAB> защита <TAB> действие
    list="$(
        printf '%s\t%s\t%s\t%s\n' "↻" "обновить список" "—" "Enter"
        if [ -n "$cur" ]; then
            printf '●\t%s\t%s\t%s\n' "$cur" "подключено" "отключить"
        fi
        printf '%s\t%s\t%s\t%s\n' "?" "подсказка" "—" "команды nmcli"
        networks | awk -F"\t" -v cur="$cur" '{
            n = int($2 / 25) + 1;
            bars = "";
            for (i = 0; i < 4; i++)
                bars = bars (i < n ? "▆" : "▁");
            lock = ($3 == "open" ? "открытая" : "защищённая");
            mark = ($1 == cur ? "сейчас" : $2 "%");
            printf "%s\t%s\t%s\t%s\n", bars, $1, lock, mark;
        }'
    )"

    local choice ssid pass sec chosen_action chosen_sec
    choice="$(printf '%s\n' "$list" | rofi -dmenu -i -width 60% -lines 14 \
        -p "Wi-Fi" -mesg "выберите сеть  ·  Enter — подключиться  ·  Esc — отмена")"
    [ -n "$choice" ] || return 0

    # разбираем выбранную строку по табуляции
    chosen_action="$(printf '%s' "$choice" | cut -f4)"
    chosen_sec="$(printf '%s' "$choice" | cut -f3)"
    ssid="$(printf '%s' "$choice" | cut -f2)"

    case "$ssid" in
        "обновить список")
            main
            return $?
            ;;
        "подсказка")
            msg "$(usage)"
            return 0
            ;;
    esac

    if [ "$chosen_action" = "отключить" ]; then
        nm device disconnect "$ssid" >/dev/null 2>&1 &&
            msg "Отключено: $ssid" || msg "Не удалось отключиться"
        return 0
    fi

    # защита сети: пустая строка = открытая сеть
    if [ "$chosen_sec" = "открытая" ]; then
        sec="open"
    else
        sec="$(networks | awk -F"\t" -v s="$ssid" '$1==s{print $3; exit}')"
    fi

    if [ "$sec" = "open" ] || [ -z "$sec" ]; then
        if nm device wifi connect "$ssid" >/dev/null 2>&1; then
            msg "Подключено: $ssid"
            return 0
        fi
        msg "Не удалось подключиться к $ssid"
        return 1
    fi

    pass="$(printf '' | rofi -dmenu -password -i -width 46% \
        -p "Пароль" -mesg "сеть $ssid  ·  Esc — отмена")"
    [ -n "$pass" ] || { msg "Пароль не введён — отменено"; return 1; }

    if nm device wifi connect "$ssid" password "$pass" >/dev/null 2>&1; then
        sleep 1
        msg "Подключено: $ssid"
        return 0
    fi
    msg "Не удалось подключиться к $ssid: неверный пароль или сеть вне зоны"
    return 1
}

main "$@"