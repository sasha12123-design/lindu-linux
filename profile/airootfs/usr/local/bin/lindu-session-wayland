#!/bin/sh
# lindu linux — сессия Wayland (Sway).
#
# Смысл жизни этого скрипта — не дать пользователю остаться с чёрным
# экраном: если sway не установлен, его конфигурация не проходит проверку
# или композитор падает сразу после старта, мы молча уходим в X11-сессию.
#
# Панель, обои и портал запускает сам sway (exec в его конфигурации): им нужен
# WAYLAND_DISPLAY, который есть только у его потомков.

set -u
HOME_DIR="${HOME:-/root}"
# Отбрасываем суффикс (-wayland, -x11, -session), чтобы получить корень имени
# и звать соседние скрипты без зашитых имён.
BASE=$(basename "$0")
PREFIX=${BASE%-wayland}
PREFIX=${PREFIX%-x11}
PREFIX=${PREFIX%-session}
HERE=$(dirname "$0")
X11BIN="$HERE/$PREFIX-session-x11"
CFG="$HOME_DIR/.config/sway/config"
LOG="$HOME_DIR/.lindu-session.log"

log() {
    printf '%s %s\n' "$(date '+%H:%M:%S')" "$*" >>"$LOG" 2>/dev/null
    printf '[lindy] %s\n' "$*"
}

export XDG_CURRENT_DESKTOP=LINDU
export XDG_SESSION_DESKTOP=lindudesktop
export XDG_SESSION_TYPE=wayland
export XDG_SEAT="seat0"

# каталог для сокетов и файлов сессии
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    XDG_RUNTIME_DIR="/run/user/$(id -u)"
    export XDG_RUNTIME_DIR
fi
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null

# 1) композитор вообще есть?
if ! command -v sway >/dev/null 2>&1; then
    log "sway не установлен — ухожу в X11"
    exec "$X11BIN"
fi

# 2) конфигурация должна быть без ошибок (иначе чёрный экран)
if [ -r "$CFG" ] && ! sway --validate -c "$CFG" >/tmp/lindu-sway-check.log 2>&1; then
    log "конфигурация sway не проходит проверку — ухожу в X11"
    while IFS= read -r line; do log "  $line"; done </tmp/lindu-sway-check.log 2>/dev/null
    exec "$X11BIN"
fi

log "запускаю сессию Wayland (Sway)"

# службы, которым Wayland не нужен (звук, питание, папки, права)
pipewire >/dev/null 2>&1 &
pipewire-pulse >/dev/null 2>&1 &
acpid >/dev/null 2>&1 &
xdg-user-dirs-update >/dev/null 2>&1 &
if [ -x /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 ]; then
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 >/dev/null 2>&1 &
fi

# композитор. Его вывод пишем в отдельный файл: по нему поймаем плохой конфиг.
SWAY_ERR="$XDG_RUNTIME_DIR/lindu-sway-start.log"
BAD="$XDG_RUNTIME_DIR/lindu-sway-bad"
rm -f "$BAD" 2>/dev/null
: >"$SWAY_ERR"

STARTED=$(date +%s)

# Пробуем обычный рендеринг. Если окна не появились (частая история для
# ноутбучных видеокарт: мышь работает, экран чёрный) — повторяем с
# программным рендерингом, и только потом уходим в X11.
sway_start() {
    WLR_RENDERER="$1" sway -c "$CFG" >>"$SWAY_ERR" 2>&1 &
    SWAY_PID=$!
}

# есть ли рабочие рабочие области: если их нет — рендерить нечего
sway_alive() {
    kill -0 "$SWAY_PID" 2>/dev/null || return 1
    swaymsg -t get_workspaces 2>/dev/null | grep -q '"name"' && return 0
    return 1
}

sway_start "${WLR_RENDERER:-auto}"
sleep 8
if ! sway_alive; then
    log "sway запустился, но рабочие области не появились — пробую программный рендеринг"
    pkill -x sway 2>/dev/null
    sleep 2
    sway_start pixman
    sleep 8
    if ! sway_alive; then
        log "с программным рендерингом тоже нет результата — ухожу в X11"
        touch "$BAD"
    fi
fi

# Если в конфиге есть ошибки, sway показывает красный экран и ЖДЁТ нажатия —
# пользователь остаётся без рабочего стола. Поэтому через 12 секунд смотрим
# журнал запуска: если sway жаловался на конфигурацию, закрываем его и
# переходим в X11, чтобы человек попал в рабочее окружение.
(
    sleep 12
    # плохой конфиг: sway показывает красный экран и ждёт — закрываем его
    if [ -s "$SWAY_ERR" ] && grep -qiE "errors in your config|Error on line|Overwriting binding|requires binding|Unknown/invalid command" "$SWAY_ERR" 2>/dev/null; then
        touch "$BAD"
        pkill -x sway 2>/dev/null
        exit
    fi
    # панель и обои должны жить: если процесс упал, поднимаем ещё раз
    sleep 8
    pgrep -x sway >/dev/null 2>&1 || exit
    pgrep -x waybar >/dev/null 2>&1 || waybar >/dev/null 2>&1 &
    pgrep -x swaybg >/dev/null 2>&1 || swaybg -m fill -c "#0a0f22" \
        /usr/share/backgrounds/lindy.png >/dev/null 2>&1 &
) &
WATCH_PID=$!

wait "$SWAY_PID"
RC=$?
SPENT=$(( $(date +%s) - STARTED ))

kill "$WATCH_PID" 2>/dev/null

# конфиг оказался плохим — показываем почему и уходим в X11
if [ -f "$BAD" ]; then
    log "sway сообщил о проблемах с конфигурацией, ухожу в X11:"
    while IFS= read -r line; do log "  $line"; done <"$SWAY_ERR" 2>/dev/null
    exec "$X11BIN"
fi

# падение с ненулевым кодом почти сразу = отказ, а не выход пользователя
if [ "$RC" -ne 0 ] && [ "$SPENT" -lt 120 ]; then
    log "sway завершился через ${SPENT}с с кодом $RC — это отказ, ухожу в X11"
    exec "$X11BIN"
fi

log "сессия Wayland завершена (код $RC, ${SPENT}с)"
pkill -P $$ 2>/dev/null
exit 0