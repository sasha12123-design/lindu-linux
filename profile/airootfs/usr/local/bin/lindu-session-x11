#!/bin/sh
# lindu linux — сессия X11 (оконный менеджер lindu-wm).
#
# Запасной вариант: включается в настройках (раздел «Система» → сессия X11).

set -u
HOME_DIR="${HOME:-/root}"
LOG="$HOME_DIR/.lindu-session.log"

printf '%s запуск сессии X11\n' "$(date '+%H:%M:%S')" >>"$LOG" 2>/dev/null
printf '[lindy] сессия X11\n'

# если вдруг осталась переменная от другой сессии — убрать
unset WAYLAND_DISPLAY 2>/dev/null || true
unset XDG_SESSION_TYPE 2>/dev/null || true

exec startx