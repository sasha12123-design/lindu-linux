#!/bin/sh
# lindu linux — выбор графической сессии при входе.
#
# Основная сессия — Wayland (Sway). Сессия X11 с нашим оконным менеджером
# остаётся запасной: переключается в программе настроек (раздел «Система»).
#
# Выбор хранится в ~/.config/lindu/session:
#     session = wayland     по умолчанию
#     session = x11

set -u
HOME_DIR="${HOME:-/root}"
SESSION_FILE="$HOME_DIR/.config/lindu/session"
# Отбрасываем суффикс (-wayland, -x11, -session), чтобы получить корень имени
# и звать соседние скрипты без зашитых имён.
HERE=$(dirname "$0")
# Соседние скрипты ищем по шаблону: так не важно, как называется сам файл.
sibling() {
    ls "$1"/*-session-$2 2>/dev/null | head -n 1
}
DEFAULT_SESSION="wayland"

log() { printf '[lindy-session] %s\n' "$*"; }

session=""
if [ -r "$SESSION_FILE" ]; then
    v=$(sed -n 's/^[[:space:]]*session[[:space:]]*=[[:space:]]*"\?\([a-z0-9]*\)"\?[[:space:]]*$/\1/p' \
            "$SESSION_FILE" 2>/dev/null | tail -n 1)
    [ -n "$v" ] && session="$v"
fi

# Если человек ничего не выбирал, подбираем сами.
if [ -z "$session" ] || [ "$session" = "auto" ]; then
    # Авто: пробуем Wayland. Если он не заведётся (например, в виртуальной
    # машине без настоящей видеокарты) — скрипт сессии сам уйдёт в X11
    # и напишет причину в журнал.
    session="$DEFAULT_SESSION"
    log "сессия не выбрана вручную: беру $session"
    log "если Wayland не заведётся, система сама переключится на X11"
fi
log "итог: $session"

case "$session" in
    x11|X11|startx)
        exec "$(sibling "$HERE" x11)"
        ;;
    *)
        exec "$(sibling "$HERE" wayland)"
        ;;
esac